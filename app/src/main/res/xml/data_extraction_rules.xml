<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12 (API 31) and above.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Cloud backup rules (Google Drive backup) -->
    <cloud-backup>
        <!-- Include user settings (DataStore preferences) -->
        <include domain="file" path="datastore/settings.preferences_pb" />
        
        <!-- Include detection history database -->
        <include domain="database" path="peek_detector_database" />
        <include domain="database" path="peek_detector_database-shm" />
        <include domain="database" path="peek_detector_database-wal" />
        
        <!-- Exclude cache files -->
        <exclude domain="cache" path="." />
        
        <!-- Exclude no-backup files -->
        <exclude domain="file" path="no_backup" />
        
        <!-- Exclude temporary/generated files -->
        <exclude domain="external" path="." />
    </cloud-backup>
    
    <!-- Device-to-device transfer rules -->
    <device-transfer>
        <!-- Include user settings (DataStore preferences) -->
        <include domain="file" path="datastore/settings.preferences_pb" />
        
        <!-- Include detection history database -->
        <include domain="database" path="peek_detector_database" />
        <include domain="database" path="peek_detector_database-shm" />
        <include domain="database" path="peek_detector_database-wal" />
        
        <!-- Exclude cache files -->
        <exclude domain="cache" path="." />
        
        <!-- Exclude no-backup files -->
        <exclude domain="file" path="no_backup" />
        
        <!-- Exclude temporary/generated files -->
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>