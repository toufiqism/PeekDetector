<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PeekDetector" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/gradient_start</item>
        <item name="android:navigationBarColor">@color/gradient_end</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    
    <style name="Theme.PeekDetector.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
